{
  "name": "agent-ui-lab",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "start": "node --import tsx src/server.ts",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.1",
    "@ag-ui/core": "^1.0.1",
    "@ag-ui/encoder": "^1.0.1",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/core": "^2.3.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.0",
    "ajv": "^8.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
